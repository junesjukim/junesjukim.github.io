<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% capture full_name %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
    {% if page.url == '/' %}
      {% assign page_title = full_name %}
    {% else %}
      {% capture page_title %}{{ page.title }} · {{ full_name }}{% endcapture %}
    {% endif %}
    {% assign page_desc = page.description | default: site.description | strip_html | strip_newlines | truncate: 160 %}
    <title>{{ page_title }}</title>
    <meta name="description" content="{{ page_desc }}">
    <meta name="author" content="{{ full_name }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ page_title }}">
    <meta property="og:description" content="{{ page_desc }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    {% if page.thumb %}<meta property="og:image" content="{{ page.thumb | absolute_url }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2220%22 fill=%22%23141413%22/><text x=%2250%22 y=%2270%22 font-family=%22Georgia,serif%22 font-size=%2260%22 font-weight=%22700%22 fill=%22%23faf9f5%22 text-anchor=%22middle%22>J</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Source+Sans+3:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | relative_url }}?v={{ site.time | date: '%s' }}">
    <script>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark') document.documentElement.classList.add('theme-dark');
          if (t === 'light') document.documentElement.classList.add('theme-light');
        } catch (e) {}
      })();
    </script>
    {% if page.math %}
      <script>
        window.MathJax = { tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] }, svg: { fontCache: 'global' } };
      </script>
      <script defer src="https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-svg.js"></script>
    {% endif %}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="{{ '/' | relative_url }}">{{ site.first_name }} {{ site.last_name }}</a>
        <nav class="nav" aria-label="Main">
          <a href="{{ '/#about' | relative_url }}">About</a>
          <a href="{{ '/#news' | relative_url }}">News</a>
          <a href="{{ '/#research' | relative_url }}">Research</a>
          <a href="{{ '/projects/' | relative_url }}" {% if page.url contains '/projects/' %}aria-current="page"{% endif %}>Projects</a>
          <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
            <i class="fa-solid fa-moon" aria-hidden="true"></i>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      {{ content }}
    </main>

    <footer class="site-footer">
      <div class="container">© {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</div>
    </footer>

    <script>
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector('.theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var dark = root.classList.contains('theme-dark') ||
            (!root.classList.contains('theme-light') && window.matchMedia('(prefers-color-scheme: dark)').matches);
          root.classList.remove('theme-dark', 'theme-light');
          root.classList.add(dark ? 'theme-light' : 'theme-dark');
          try { localStorage.setItem('theme', dark ? 'light' : 'dark'); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
